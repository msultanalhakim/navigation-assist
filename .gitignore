# Navigation Assist ML Pipeline - .gitignore
# ==========================================

# ============================================
# DATASETS & DATA
# ============================================
data/
dataset/
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff

# Exclude sample data (if you want to keep examples)
!docs/images/*.png
!docs/images/*.jpg

# ============================================
# MODELS & WEIGHTS
# ============================================
# PyTorch models
*.pt
*.pth
*.weights
*.ckpt

# TFLite models
*.tflite

# ONNX models
*.onnx

# Model directories
models/
runs/
weights/

# Training outputs
navigation-assistance/
yolo*/

# ============================================
# CACHE & TEMPORARY FILES
# ============================================
cache/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ============================================
# LOGS & OUTPUTS
# ============================================
logs/
*.log
outputs/
results/
*.csv
*.json

# Exclude config files (keep them)
!config.yaml
!config.json
!package.json

# ============================================
# JUPYTER NOTEBOOKS
# ============================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Keep notebooks but ignore outputs
# *.ipynb  # Uncomment if you don't want notebooks in Git

# ============================================
# PYTHON VIRTUAL ENVIRONMENTS
# ============================================
venv/
env/
ENV/
.venv/
.ENV/
virtualenv/

# ============================================
# IDE & EDITORS
# ============================================
# VSCode
.vscode/
.history/

# PyCharm
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ============================================
# OPERATING SYSTEM
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ============================================
# BACKUPS & ARCHIVES
# ============================================
backup_*/
*.backup
*.bak
*.tmp
*.zip
*.tar.gz
*.rar
*.7z

# ============================================
# TESTING & COVERAGE
# ============================================
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# ============================================
# ENVIRONMENT VARIABLES
# ============================================
.env
.env.local
.env.*.local

# ============================================
# PROJECT SPECIFIC
# ============================================
# Temporary processing folders
_merged*/
_combined*/
*_augmented/
train_augmented/

# Search results
random_search/
grid_search/

# Annotations verification
annotation_verification_report.json
selective_test_results.json

# TODO files
todo.json
TODO.txt
